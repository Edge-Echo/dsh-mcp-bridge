{
  "name": "dsh-mcp-bridge",
  "version": "0.1.0",
  "description": "Curated, verified MCP server bundle for DeepSeek Harness (dsh): one install brings demo, memory, filesystem, GitHub, Playwright and remote HTTP MCP servers, with a connectivity verifier and CI checks.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-mcp-bridge contributors",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "cordis",
    "deepseek"
  ],
  "files": [
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "servers",
    "scripts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edge-Echo/dsh-mcp-bridge.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "verify": "node scripts/verify-servers.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.6"
  }
}
